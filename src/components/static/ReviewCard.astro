---
interface Props {
  name: string
  rating: number
  text: string
  source: string
  email?: string
}

const { name, rating, text, source, email } = Astro.props
const reportSubject = `Review removal request — ${name}`
const reportBody = `I would like to request the removal of the following review:\n\nReviewer: ${name}\nSource: ${source}\nReview text: "${text}"\n\nReason for removal:\n`
const reportHref = email
  ? `mailto:${email}?subject=${encodeURIComponent(reportSubject)}&body=${encodeURIComponent(reportBody)}`
  : undefined
---

<div
  class="rounded-xl p-5 flex flex-col gap-4 h-full"
  style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);"
>
  <!-- Stars -->
  <div class="flex items-center gap-0.5" role="img" aria-label={`${rating} out of 5 stars`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill={i < rating ? '#facc15' : 'var(--color-border)'}
        stroke={i < rating ? '#facc15' : 'var(--color-border)'}
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    ))}
  </div>

  <!-- Quote text -->
  <blockquote
    class="flex-1 text-sm leading-relaxed"
    style="color: var(--color-foreground);"
  >
    &ldquo;{text}&rdquo;
  </blockquote>

  <!-- Footer: name + source badge -->
  <div
    class="flex items-center justify-between pt-3"
    style="border-top: 1px solid var(--color-border);"
  >
    <span class="font-semibold text-sm" style="color: var(--color-foreground);">
      {name}
    </span>
    <div class="flex items-center gap-2">
      {reportHref && (
        <a
          href={reportHref}
          class="text-xs opacity-40 hover:opacity-70 transition-opacity"
          title="Report this review"
          aria-label={`Report review by ${name}`}
        >
          Report
        </a>
      )}
      <span
        class="text-xs font-medium px-2.5 py-1 rounded-full"
        style="background-color: var(--color-surface-alt); color: var(--color-foreground-muted);"
      >
        {source}
      </span>
    </div>
  </div>
</div>
