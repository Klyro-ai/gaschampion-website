---
import { getTenantData } from '../../lib/tenant'
const { business } = await getTenantData()

const phoneHref = `tel:${business.phone.replace(/\s/g, '')}`

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Blog', href: '/blog' },
  { label: 'Areas', href: '/service-areas' },
  { label: 'Contact', href: '/contact' },
]
---

<!-- Pure CSS mobile nav — zero JavaScript -->
<div class="lg:hidden">
  <input type="checkbox" id="mobile-nav-toggle" class="peer sr-only" />
  <label
    for="mobile-nav-toggle"
    class="flex items-center justify-center cursor-pointer"
    style="min-width: 44px; min-height: 44px;"
    aria-label="Toggle navigation menu"
  >
    <!-- Hamburger icon (visible when closed) -->
    <svg class="peer-checked:hidden block" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M3 6h18M3 18h18" /></svg>
    <!-- X icon (visible when open) -->
    <svg class="hidden peer-checked:block" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12" /></svg>
  </label>

  <!-- Menu panel -->
  <div
    class="absolute left-0 right-0 top-full z-50 border-t shadow-theme-lg max-h-0 overflow-hidden opacity-0 peer-checked:max-h-screen peer-checked:opacity-100"
    style="background-color: var(--color-nav-bg); border-color: var(--color-border); transition: max-height 0.3s ease, opacity 0.2s ease;"
  >
    <nav class="px-5 py-5 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="flex items-center px-4 py-3.5 rounded-theme text-base font-medium hover:opacity-70 transition-opacity"
          style="min-height: 48px;"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3">
        <a
          href={phoneHref}
          class="flex items-center justify-center gap-2 w-full px-4 py-4 rounded-theme-full font-bold text-base"
          style="background-color: var(--color-cta-bg); color: var(--color-cta-text); min-height: 52px;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg>
          {business.phone}
        </a>
      </div>
    </nav>
  </div>
</div>

<style>
  /* Icon swap via sibling selector */
  #mobile-nav-toggle:checked ~ label svg:first-of-type { display: none; }
  #mobile-nav-toggle:checked ~ label svg:last-of-type { display: block; }
</style>
