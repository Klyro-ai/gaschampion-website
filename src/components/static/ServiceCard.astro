---
interface Props {
  id: string
  name: string
  shortDesc: string
  icon: string
  fromPrice: string
  features: string[]
}

const { id, name, shortDesc, icon, fromPrice, features } = Astro.props

const iconPaths: Record<string, string> = {
  wrench: 'M21.71 20.29l-1.42 1.42a1 1 0 01-1.42 0l-5.66-5.66a6.5 6.5 0 01-7.07-1.07 6.5 6.5 0 01-.84-8.2l3.54 3.53 2.12-2.12-3.54-3.54a6.5 6.5 0 018.2.84 6.5 6.5 0 011.07 7.07l5.66 5.66a1 1 0 010 1.42z',
  flame: 'M12 2c1 4-2 6-2 10a4 4 0 008 0c0-4-3-6-2-10M10 16a2 2 0 004 0c0-2-1-3-2-4-1 1-2 2-2 4z',
  'clipboard-check': 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  'shield-check': 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4',
  droplets: 'M12 2.69l5.66 5.66a8 8 0 11-11.31 0z',
  smartphone: 'M17 2H7a2 2 0 00-2 2v16a2 2 0 002 2h10a2 2 0 002-2V4a2 2 0 00-2-2zM12 18h.01',
  thermometer: 'M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z',
  droplet: 'M12 2.69l5.66 5.66a8 8 0 11-11.31 0z',
}

const svgPath = iconPaths[icon] || iconPaths.wrench

/* Show 2 features on mobile, 3 on sm+ (handled via CSS) */
const allFeatures = features.slice(0, 3)
---

<a
  href={`/services/${id}`}
  class="service-card group block rounded-xl p-5 sm:p-6 h-full flex flex-col transition-all hover:-translate-y-1 hover:shadow-lg"
  style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);"
>
  <!-- Icon -->
  <div
    class="w-11 h-11 rounded-lg flex items-center justify-center mb-4 shrink-0"
    style="background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={svgPath} />
    </svg>
  </div>

  <!-- Title -->
  <h3 class="text-base font-bold mb-2" style="color: var(--color-foreground);">
    {name}
  </h3>

  <!-- Description: 2-line clamp -->
  <p
    class="text-sm leading-relaxed mb-4 flex-1"
    style="color: var(--color-foreground-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
  >
    {shortDesc}
  </p>

  <!-- Features list -->
  <ul class="flex flex-col gap-2 mb-4">
    {allFeatures.map((feature, i) => (
      <li
        class:list={[
          'flex items-start gap-2 text-sm',
          { 'hidden sm:flex': i >= 2 },
        ]}
        style="color: var(--color-foreground);"
      >
        <svg class="shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6L9 17l-5-5" />
        </svg>
        {feature}
      </li>
    ))}
  </ul>

  <!-- Price row -->
  <div
    class="flex items-center justify-between pt-4 mt-auto"
    style="border-top: 1px solid var(--color-border);"
  >
    <span class="text-sm font-bold" style="color: var(--color-primary);">
      From {fromPrice}
    </span>
    <span
      class="text-sm font-medium flex items-center gap-1 transition-all group-hover:gap-2"
      style="color: var(--color-accent);"
    >
      Learn more
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
