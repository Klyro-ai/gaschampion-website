---
import { business } from '../../data/business'

const phoneHref = `tel:${business.phone.replace(/\s/g, '')}`
---

<div
  class="w-full py-2.5 px-4"
  style="background-color: var(--color-primary); color: var(--color-primary-text, #fff);"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
    <!-- Phone -->
    <a
      href={phoneHref}
      class="inline-flex items-center gap-1.5 transition-colors shrink-0"
      style="color: inherit; min-height: 44px; min-width: 44px; font-size: 13px; line-height: 1;"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
      </svg>
      <span class="font-medium">{business.phone}</span>
    </a>

    <!-- Email (hidden on mobile, visible on md+) -->
    <a
      href={`mailto:${business.email}`}
      class="hidden md:inline-flex items-center gap-1.5 transition-colors"
      style="color: inherit; opacity: 0.9; font-size: 13px;"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
        <path d="M22 6l-10 7L2 6" />
      </svg>
      <span>{business.email}</span>
    </a>

    <!-- Gas Safe -->
    <div
      class="inline-flex items-center gap-1.5"
      style="font-size: 13px; color: inherit; opacity: 0.95;"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        <path d="M9 12l2 2 4-4" />
      </svg>
      <span class="font-medium hidden sm:inline">Gas Safe: {business.gasSafeNumber}</span>
      <span class="font-medium sm:hidden">{business.gasSafeNumber}</span>
    </div>
  </div>
</div>
