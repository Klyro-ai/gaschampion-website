---
const { business } = Astro.locals.tenant

const phoneHref = `tel:${business.phone.replace(/\s/g, '')}`
---

<section
  class="py-14 sm:py-16 md:py-20 px-5 sm:px-6"
  style="background-color: var(--color-primary);"
>
  <div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-5 sm:gap-6">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white leading-tight">
      Need a Heating Engineer Today?
    </h2>
    <p class="text-base sm:text-lg text-white/80 max-w-2xl leading-relaxed">
      Whether it's an emergency repair or a routine service, we're here to help.
      Gas Safe registered engineers available for same-day callouts.
    </p>
    <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4 pt-2 w-full sm:w-auto">
      <!-- Primary CTA: phone -->
      <a
        href={phoneHref}
        class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-7 rounded-full text-base font-bold transition-all hover:scale-[1.02] active:scale-[0.98]"
        style="background-color: #fff; color: var(--color-primary); min-height: 48px;"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
        </svg>
        {business.phone}
      </a>

      <!-- Secondary CTA: contact page -->
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-7 rounded-full text-base font-bold text-white transition-all hover:bg-white/10 active:scale-[0.98]"
        style="border: 2px solid rgba(255,255,255,0.8); min-height: 48px;"
      >
        Request a Callback
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
