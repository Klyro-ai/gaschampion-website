---
import { analytics, isConfigured } from '../../config/analytics'

const clarityReady = analytics.clarity.enabled && isConfigured(analytics.clarity.projectId)
const searchConsoleReady = isConfigured(analytics.searchConsole.verificationId)
const plausibleReady = analytics.plausible.enabled && analytics.plausible.domain.length > 0
---

{/* Google Search Console verification */}
{searchConsoleReady && (
  <meta name="google-site-verification" content={analytics.searchConsole.verificationId} />
)}

{/* Microsoft Clarity — loaded ONLY after cookie consent */}
{clarityReady && (
  <script
    type="text/javascript"
    is:inline
    define:vars={{ clarityId: analytics.clarity.projectId }}
  >
    // Register loader — called by CookieConsent banner on accept
    window.__klyroLoadAnalytics = function() {
      if (window.__klyroAnalyticsLoaded) return;
      window.__klyroAnalyticsLoaded = true;
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script",clarityId);
    };

    // Auto-load if consent was previously given
    if (document.cookie.match(/(?:^|;\s*)klyro_consent=1/)) {
      window.__klyroLoadAnalytics();
    }
  </script>
)}

{/* Plausible — only when explicitly enabled */}
{plausibleReady && (
  <script
    defer
    data-domain={analytics.plausible.domain}
    src="https://plausible.io/js/script.js"
  />
)}
