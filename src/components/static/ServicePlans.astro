---
const { business, servicePlans } = Astro.locals.tenant

const phoneHref = `tel:${business.phone.replace(/\s/g, '')}`
---

<section class="py-14 sm:py-16 md:py-24 px-4">
  <div class="max-w-5xl mx-auto">
    <!-- Section heading -->
    <div class="text-center mb-10 sm:mb-12">
      <h2
        class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 sm:mb-4"
        style="color: var(--color-foreground);"
      >
        Service Plans
      </h2>
      <p
        class="text-base sm:text-lg max-w-2xl mx-auto leading-relaxed"
        style="color: var(--color-foreground-muted);"
      >
        Keep your boiler running smoothly with one of our affordable care plans. No hidden fees, cancel anytime.
      </p>
    </div>

    <!-- Plans grid: stack on mobile, side-by-side on md+ -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-3xl mx-auto">
      {servicePlans.map((plan) => (
        <div
          class="relative rounded-xl p-6 sm:p-8 flex flex-col gap-5 sm:gap-6"
          style={plan.popular
            ? 'background-color: var(--color-card-bg); border: 2px solid var(--color-primary); box-shadow: 0 4px 24px rgba(0,0,0,0.08);'
            : 'background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);'
          }
        >
          {/* Most Popular badge */}
          {plan.popular && (
            <div
              class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full text-xs font-bold text-white whitespace-nowrap"
              style="background-color: var(--color-primary);"
            >
              Most Popular
            </div>
          )}

          {/* Plan name */}
          <h3
            class="text-lg sm:text-xl font-bold text-center"
            style="color: var(--color-foreground);"
          >
            {plan.name}
          </h3>

          {/* Price */}
          <div class="text-center">
            <span
              class="text-3xl sm:text-4xl font-bold"
              style="color: var(--color-primary);"
            >
              {plan.price}
            </span>
            <span
              class="text-sm sm:text-base"
              style="color: var(--color-foreground-muted);"
            >
              {plan.period}
            </span>
          </div>

          {/* Features */}
          <ul class="flex flex-col gap-3">
            {plan.features.map((feature) => (
              <li
                class="flex items-center gap-2.5 text-sm"
                style="color: var(--color-foreground);"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          {/* CTA button: min h-12 for touch target */}
          <a
            href={phoneHref}
            class="mt-auto flex items-center justify-center gap-2 w-full rounded-lg text-sm font-semibold transition-opacity hover:opacity-90"
            style={`min-height: 48px; ${plan.popular
              ? 'background-color: var(--color-primary); color: #fff;'
              : 'background-color: transparent; border: 2px solid var(--color-primary); color: var(--color-primary);'
            }`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
            </svg>
            Call to Sign Up
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
