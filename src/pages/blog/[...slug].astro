---
import Base from '../../layouts/Base.astro'
import { MobileNavIsland } from '../../components/interactive/AppIslands'
import TopBar from '../../components/static/TopBar.astro'
import Header from '../../components/static/Header.astro'
import CTABanner from '../../components/static/CTABanner.astro'
import Footer from '../../components/static/Footer.astro'



import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({ params: { slug: post.id || post.slug }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Base title={post.data.title} description={post.data.description}>
  
    <TopBar />
    <Header><MobileNavIsland client:only="react" /></Header>

    <article class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-4">
        <div class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xs font-medium px-2 py-1 rounded-theme-full" style="background-color: color-mix(in srgb, var(--color-primary) 15%, transparent); color: var(--color-primary)">{post.data.tags?.[0]}</span>
            <span class="text-sm" style="color: var(--color-foreground-muted)">{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </div>
          <h1 class="font-heading text-[1.65rem] sm:text-4xl md:text-5xl font-bold mb-4">{post.data.title}</h1>
          <p class="text-lg" style="color: var(--color-foreground-muted)">{post.data.description}</p>
        </div>
        <div class="prose prose-lg max-w-none" style="color: var(--color-foreground); overflow-wrap: break-word;">
          <Content />
        </div>
      </div>
    </article>

    <CTABanner />
    <Footer />
    
  
</Base>
