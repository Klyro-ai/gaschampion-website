---
import Base from '../../layouts/Base.astro'
import { MobileNavIsland } from '../../components/interactive/AppIslands'
import TopBar from '../../components/static/TopBar.astro'
import Header from '../../components/static/Header.astro'
import Footer from '../../components/static/Footer.astro'



import { getCollection } from 'astro:content'

const posts = (await getCollection('blog')).filter(p => !p.data.draft).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Base title="Blog" description="Expert heating and boiler tips from a Gas Safe registered engineer.">
  
    <TopBar />
    <Header><MobileNavIsland client:only="react" /></Header>

    <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold mb-4">Heating & Boiler Tips</h1>
        <p class="text-lg" style="color: var(--color-foreground-muted)">Expert advice from a Gas Safe registered engineer with 18+ years of experience.</p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-8">
          {posts.map((post) => {
            const slug = post.id || post.slug || ''
            const imgSrc = slug.includes('service') ? '/images/blog-boiler-service.svg' : slug.includes('safety') ? '/images/blog-gas-safety.svg' : '/images/blog-radiator.svg'
            return (
            <a href={`/blog/${slug}`} class="block p-5 sm:p-6 rounded-theme-lg border hover:shadow-theme-lg hover:-translate-y-1 transition-all group h-full" style="background-color: var(--color-card-bg); border-color: var(--color-card-border);">
              <div class="rounded-theme mb-4 overflow-hidden">
                <img
                  src={imgSrc}
                  alt={post.data.title}
                  class="w-full h-auto aspect-video object-cover"
                  width="640"
                  height="360"
                  loading="lazy"
                />
              </div>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs font-medium px-2 py-1 rounded-theme-full" style="background-color: color-mix(in srgb, var(--color-primary) 15%, transparent); color: var(--color-primary)">{post.data.tags?.[0] || 'Tips'}</span>
                <span class="text-xs" style="color: var(--color-foreground-muted)">{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              </div>
              <h2 class="font-heading font-bold text-xl mb-2">{post.data.title}</h2>
              <p class="text-sm" style="color: var(--color-foreground-muted)">{post.data.description}</p>
              <div class="mt-4 flex items-center gap-1 text-sm font-medium" style="color: var(--color-accent)">Read more <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" /></svg></div>
            </a>
          )})}

        </div>
      </div>
    </section>

    <Footer />
    
  
</Base>
