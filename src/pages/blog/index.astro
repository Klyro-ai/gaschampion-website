---
import Base from '../../layouts/Base.astro'
import MobileNav from '../../components/static/MobileNav.astro'
import TopBar from '../../components/static/TopBar.astro'
import Header from '../../components/static/Header.astro'
import Footer from '../../components/static/Footer.astro'
import { getPublishedBlogPosts, imageUrl } from '../../lib/klyro-api'

const { clientId, apiBase, apiKey, apiFetch, business } = Astro.locals.tenant
const isGasChampion = clientId === 'gaschampion'
const posts = await getPublishedBlogPosts(apiFetch, apiKey, clientId)
---

<Base title="Blog" description="Expert heating and boiler tips from a Gas Safe registered engineer.">

    <TopBar />
    <Header><MobileNav /></Header>

    <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold mb-4">Heating & Boiler Tips</h1>
        <p class="text-lg" style="color: var(--color-foreground-muted)">Expert advice from a Gas Safe registered engineer{business.yearsExperience > 0 ? ` with ${business.yearsExperience}+ years of experience` : ''}.</p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4">
        {posts.length === 0 ? (
          <p class="text-center text-lg" style="color: var(--color-foreground-muted)">No posts yet — check back soon!</p>
        ) : (
        <div class="grid md:grid-cols-2 gap-8">
          {posts.map((post) => {
            const tags = (() => { try { return JSON.parse(post.tags || '[]') } catch { return [] } })()
            const firstTag = tags[0] || 'Tips'
            const dateStr = post.published_at ? new Date(post.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : ''
            const imgSrc = post.image_url
              ? imageUrl(apiBase, post.image_url)
              : isGasChampion
                ? (post.slug.includes('service') ? '/images/blog-boiler-service.svg' : post.slug.includes('safety') ? '/images/blog-gas-safety.svg' : '/images/blog-radiator.svg')
                : null
            return (
            <a href={`/blog/${post.slug}`} class="block p-5 sm:p-6 rounded-theme-lg border hover:shadow-theme-lg hover:-translate-y-1 transition-all group h-full" style="background-color: var(--color-card-bg); border-color: var(--color-card-border);">
              <div class="rounded-theme mb-4 overflow-hidden">
                {imgSrc ? (
                  <img
                    src={imgSrc}
                    alt={post.image_alt_text || post.title}
                    class="w-full h-auto aspect-video object-cover"
                    width="640"
                    height="360"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full aspect-video flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                    <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: rgba(255,255,255,0.6);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
                  </div>
                )}
              </div>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs font-medium px-2 py-1 rounded-theme-full" style="background-color: color-mix(in srgb, var(--color-primary) 15%, transparent); color: var(--color-primary)">{firstTag}</span>
                <span class="text-xs" style="color: var(--color-foreground-muted)">{dateStr}</span>
              </div>
              <h2 class="font-heading font-bold text-xl mb-2">{post.title}</h2>
              <p class="text-sm" style="color: var(--color-foreground-muted)">{post.description}</p>
              <div class="mt-4 flex items-center gap-1 text-sm font-medium" style="color: var(--color-accent)">Read more <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" /></svg></div>
            </a>
          )})}
        </div>
        )}
      </div>
    </section>

    <Footer />


</Base>
