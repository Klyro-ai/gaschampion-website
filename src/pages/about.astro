---
import Base from '../layouts/Base.astro'
import MobileNav from '../components/static/MobileNav.astro'
import TopBar from '../components/static/TopBar.astro'
import Header from '../components/static/Header.astro'
import WhyChooseUs from '../components/static/WhyChooseUs.astro'
import CTABanner from '../components/static/CTABanner.astro'
import Footer from '../components/static/Footer.astro'



const { business, clientId, layoutConfig } = Astro.locals.tenant
const isGasChampion = clientId === 'gaschampion'
const aboutVariant = layoutConfig?.about || 'story'
---

<Base title="About" description={business.owner ? `Meet ${business.owner}, your local Gas Safe registered engineer in ${business.address.town}.` : `Your local Gas Safe registered engineer in ${business.address.town}.`}>

    <TopBar />
    <Header><MobileNav /></Header>

    {aboutVariant === 'stats' ? (
      <!-- STATS variant — lead with big numbers, brief text below -->
      <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
        <div class="max-w-7xl mx-auto px-4">

          <div class="text-center mb-12 md:mb-16">
            <h1 class="font-heading text-[1.65rem] sm:text-4xl md:text-5xl font-bold mb-4">
              {business.owner ? `${business.owner}` : business.shortName}
            </h1>
            <p class="text-base sm:text-lg max-w-2xl mx-auto" style="color: var(--color-foreground-muted);">
              {business.tagline || `Trusted local engineer in ${business.address.town}`}
            </p>
          </div>

          <!-- Big stats row -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-12 md:mb-16">
            {business.yearsExperience > 0 && (
              <div class="text-center p-6 sm:p-8 rounded-xl" style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);">
                <div class="text-3xl sm:text-4xl md:text-5xl font-bold mb-1" style="color: var(--color-primary);">{business.yearsExperience}+</div>
                <div class="text-xs sm:text-sm font-medium uppercase tracking-wider" style="color: var(--color-foreground-muted);">Years Experience</div>
              </div>
            )}
            {business.stats.reviewCount > 0 && (
              <div class="text-center p-6 sm:p-8 rounded-xl" style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);">
                <div class="text-3xl sm:text-4xl md:text-5xl font-bold mb-1" style="color: var(--color-primary);">{business.stats.reviewCount}+</div>
                <div class="text-xs sm:text-sm font-medium uppercase tracking-wider" style="color: var(--color-foreground-muted);">5-Star Reviews</div>
              </div>
            )}
            {business.stats.averageRating > 0 && (
              <div class="text-center p-6 sm:p-8 rounded-xl" style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);">
                <div class="text-3xl sm:text-4xl md:text-5xl font-bold mb-1" style="color: var(--color-primary);">{business.stats.averageRating}</div>
                <div class="text-xs sm:text-sm font-medium uppercase tracking-wider" style="color: var(--color-foreground-muted);">Avg Rating</div>
              </div>
            )}
            <div class="text-center p-6 sm:p-8 rounded-xl" style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);">
              <div class="text-3xl sm:text-4xl md:text-5xl font-bold mb-1" style="color: var(--color-primary);">
                <svg class="w-10 h-10 sm:w-12 sm:h-12 mx-auto" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary)" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              </div>
              <div class="text-xs sm:text-sm font-medium uppercase tracking-wider" style="color: var(--color-foreground-muted);">Fully Certified</div>
            </div>
          </div>

          <!-- Brief description -->
          <div class="max-w-3xl mx-auto">
            <p class="text-base sm:text-lg mb-4 leading-relaxed" style="color: var(--color-foreground-muted)">{business.description}</p>
            {business.ownerBackground && (
              <p class="text-base sm:text-lg mb-6 leading-relaxed" style="color: var(--color-foreground-muted)">{business.ownerBackground}</p>
            )}
            <div class="flex flex-wrap gap-2 sm:gap-3">
              {business.credentials.map((c) => (
                <div class="flex items-center gap-2 px-4 py-2 rounded-theme-full text-sm font-medium" style="background-color: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5" /></svg>
                  {c.name}{c.number && <span class="opacity-60">({c.number})</span>}
                </div>
              ))}
            </div>
          </div>

        </div>
      </section>

    ) : aboutVariant === 'simple' ? (
      <!-- SIMPLE variant — clean typography, just the business description -->
      <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
        <div class="max-w-3xl mx-auto px-4">

          <h1 class="font-heading text-[1.65rem] sm:text-4xl md:text-5xl font-bold mb-8 text-center">
            About {business.shortName}
          </h1>

          <div class="prose-container">
            <p class="text-base sm:text-lg md:text-xl leading-relaxed mb-6" style="color: var(--color-foreground);">
              {business.description}
            </p>

            {business.ownerBackground && (
              <p class="text-base sm:text-lg leading-relaxed mb-8" style="color: var(--color-foreground-muted);">
                {business.ownerBackground}
              </p>
            )}

            <div class="pt-6 flex flex-col gap-4" style="border-top: 1px solid var(--color-border);">
              <div class="flex items-center gap-3">
                <svg class="shrink-0 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span class="text-sm sm:text-base" style="color: var(--color-foreground);">Serving {business.address.town} and surrounding areas</span>
              </div>
              {business.gasSafeNumber && (
                <div class="flex items-center gap-3">
                  <svg class="shrink-0 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
                  <span class="text-sm sm:text-base" style="color: var(--color-foreground);">Gas Safe Registered — {business.gasSafeNumber}</span>
                </div>
              )}
              {business.phone && (
                <div class="flex items-center gap-3">
                  <svg class="shrink-0 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                  <a href={`tel:${business.phone.replace(/\s/g, '')}`} class="text-sm sm:text-base font-semibold" style="color: var(--color-primary);">{business.phone}</a>
                </div>
              )}
            </div>

            {business.credentials.length > 0 && (
              <div class="mt-8 flex flex-wrap gap-2">
                {business.credentials.map((c) => (
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-theme-full text-xs sm:text-sm font-medium" style="background-color: color-mix(in srgb, var(--color-primary) 8%, transparent); color: var(--color-primary);">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5" /></svg>
                    {c.name}
                  </span>
                ))}
              </div>
            )}
          </div>

        </div>
      </section>

    ) : (
      <!-- STORY variant (default) — full narrative with owner background -->
      <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
        <div class="max-w-7xl mx-auto px-4">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="font-heading text-[1.65rem] sm:text-4xl md:text-5xl font-bold mb-6">{business.owner ? `Meet ${business.owner}, Your Local Gas Engineer` : 'Your Local Gas Engineer'}</h1>
              <p class="text-base sm:text-lg mb-4" style="color: var(--color-foreground-muted)">{business.ownerBackground}</p>
              <p class="text-base sm:text-lg mb-6" style="color: var(--color-foreground-muted)">{business.description}</p>
              <div class="flex flex-wrap gap-2 sm:gap-4">
                {business.credentials.map((c) => (
                  <div class="flex items-center gap-2 px-4 py-2 rounded-theme-full text-sm font-medium" style="background-color: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5" /></svg>
                    {c.name}{c.number && <span class="opacity-60">({c.number})</span>}
                  </div>
                ))}
              </div>
            </div>
            <div class="space-y-6">
              {isGasChampion ? (
                <>
                  <div class="rounded-theme-lg overflow-hidden" style="border: 1px solid var(--color-border)">
                    <img src="/images/about-engineer.svg" alt={business.owner ? `Meet ${business.owner} — Gas Safe registered engineer` : 'Gas Safe registered engineer'} class="w-full h-auto" width="500" height="600" />
                  </div>
                  <div class="rounded-theme-lg overflow-hidden" style="border: 1px solid var(--color-border)">
                    <img src="/images/engineer-on-way.png" alt={`${business.shortName} - Your engineer is on their way`} class="w-full h-auto" width="500" height="400" />
                  </div>
                  <div class="rounded-theme-lg overflow-hidden p-8 flex items-center justify-center" style="background-color: var(--color-surface-alt); border: 1px solid var(--color-border)">
                    <img src="/images/logo-full.png" alt={`${business.shortName} Logo`} width="130" height="192" style="height: 192px; width: auto; object-fit: contain; display: block;" />
                  </div>
                </>
              ) : (
                <div class="rounded-theme-lg overflow-hidden flex items-center justify-center" style={`background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border: 1px solid var(--color-border); aspect-ratio: 5/6;`}>
                  <div class="text-center p-8">
                    <svg class="w-20 h-20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: rgba(255,255,255,0.9);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    {business.owner && (
                      <p class="text-xl font-bold font-heading" style="color: rgba(255,255,255,0.95);">{business.owner}</p>
                    )}
                    {business.yearsExperience > 0 && (
                      <p class="text-sm mt-2" style="color: rgba(255,255,255,0.7);">{business.yearsExperience}+ years experience</p>
                    )}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <WhyChooseUs />
    <CTABanner />
    <Footer />


</Base>
