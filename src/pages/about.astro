---
import Base from '../layouts/Base.astro'
import MobileNav from '../components/static/MobileNav.astro'
import TopBar from '../components/static/TopBar.astro'
import Header from '../components/static/Header.astro'
import WhyChooseUs from '../components/static/WhyChooseUs.astro'
import CTABanner from '../components/static/CTABanner.astro'
import Footer from '../components/static/Footer.astro'



const { business } = Astro.locals.tenant
---

<Base title="About" description={`Meet ${business.owner}, your local Gas Safe registered engineer in ${business.address.town}.`}>
  
    <TopBar />
    <Header><MobileNav /></Header>

    <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h1 class="font-heading text-[1.65rem] sm:text-4xl md:text-5xl font-bold mb-6">Meet {business.owner}, Your Local Gas Engineer</h1>
            <p class="text-base sm:text-lg mb-4" style="color: var(--color-foreground-muted)">{business.ownerBackground}</p>
            <p class="text-base sm:text-lg mb-6" style="color: var(--color-foreground-muted)">{business.description}</p>
            <div class="flex flex-wrap gap-2 sm:gap-4">
              {business.credentials.map((c) => (
                <div class="flex items-center gap-2 px-4 py-2 rounded-theme-full text-sm font-medium" style="background-color: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary)">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5" /></svg>
                  {c.name}{c.number && <span class="opacity-60">({c.number})</span>}
                </div>
              ))}
            </div>
          </div>
          <div class="space-y-6">
            <div class="rounded-theme-lg overflow-hidden" style="border: 1px solid var(--color-border)">
              <img src="/images/about-engineer.svg" alt={`Meet ${business.owner} — Gas Safe registered engineer`} class="w-full h-auto" width="500" height="600" />
            </div>
            <div class="rounded-theme-lg overflow-hidden" style="border: 1px solid var(--color-border)">
              <img src="/images/engineer-on-way.png" alt={`${business.shortName} - Your engineer is on their way`} class="w-full h-auto" width="500" height="400" />
            </div>
            <div class="rounded-theme-lg overflow-hidden p-8 flex items-center justify-center" style="background-color: var(--color-surface-alt); border: 1px solid var(--color-border)">
              <img src="/images/logo-full.png" alt={`${business.shortName} Logo`} width="130" height="192" style="height: 192px; width: auto; object-fit: contain; display: block;" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <WhyChooseUs />
    <CTABanner />
    <Footer />
    
  
</Base>
