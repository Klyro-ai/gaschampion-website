---
import Base from '../layouts/Base.astro'
import MobileNav from '../components/static/MobileNav.astro'
import TopBar from '../components/static/TopBar.astro'
import Header from '../components/static/Header.astro'
import CTABanner from '../components/static/CTABanner.astro'
import Footer from '../components/static/Footer.astro'



const { business, clientId } = Astro.locals.tenant
const isGasChampion = clientId === 'gaschampion'
---

<Base title="Service Areas" description={`${business.shortName} covers ${business.serviceAreas.slice(0, 4).join(', ')} and surrounding areas.`}>
  
    <TopBar />
    <Header><MobileNav /></Header>

    <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold mb-4">Areas We Cover</h1>
        <p class="text-lg" style="color: var(--color-foreground-muted)">{business.shortName} provides expert boiler and heating services across {business.address.county} and surrounding areas.</p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4">
        {isGasChampion ? (
          <div class="rounded-theme-lg overflow-hidden mb-16" style="border: 1px solid var(--color-border)">
            <img src="/images/service-map.svg" alt={`${business.shortName} service area map — ${business.serviceAreas.slice(0, 4).join(', ')}`} class="w-full h-auto" width="800" height="400" />
          </div>
        ) : (
          <div class="rounded-theme-lg overflow-hidden mb-16 flex items-center justify-center p-8" style={`background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); border: 1px solid var(--color-border); min-height: 200px;`}>
            <div class="text-center">
              <svg class="w-12 h-12 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: rgba(255,255,255,0.9);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <p class="font-bold text-lg" style="color: rgba(255,255,255,0.95);">Serving {business.address.town} &amp; surrounding areas</p>
              <p class="text-sm mt-1" style="color: rgba(255,255,255,0.7);">{business.serviceAreas.slice(0, 6).join(', ')}{business.serviceAreas.length > 6 ? ' & more' : ''}</p>
            </div>
          </div>
        )}

        <h2 class="font-heading text-2xl font-bold text-center mb-8">Towns & Areas We Serve</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {business.serviceAreas.map((area) => {
            const slug = area.toLowerCase().replace(/[()]/g, '').replace(/\s+/g, '-')
            return (
              <a href={`/service-areas/${slug}`} class="flex items-center gap-3 p-4 rounded-theme-lg border transition-shadow hover:shadow-md" style="background-color: var(--color-card-bg); border-color: var(--color-card-border)">
                <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-primary)"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 13a3 3 0 100-6 3 3 0 000 6z" /></svg>
                <div>
                  <span class="font-medium">{area}</span>
                  <p class="text-xs" style="color: var(--color-foreground-muted)">Boiler repair, servicing &amp; installation</p>
                </div>
              </a>
            )
          })}
        </div>

        <div class="text-center mt-12">
          <p style="color: var(--color-foreground-muted)">Don't see your area? Give us a call — we may still be able to help.</p>
          <a href={`tel:${business.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-2 mt-4 px-6 sm:px-8 py-4 rounded-theme-full font-semibold" style="background-color: var(--color-cta-bg); color: var(--color-cta-text); min-height: 48px;">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" /></svg>
            {business.phone}
          </a>
        </div>
      </div>
    </section>

    <CTABanner />
    <Footer />
    
  
</Base>
