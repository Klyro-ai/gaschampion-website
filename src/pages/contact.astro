---
import Base from '../layouts/Base.astro'
import { MobileNavIsland, ContactFormIsland } from '../components/interactive/AppIslands'
import TopBar from '../components/static/TopBar.astro'
import Header from '../components/static/Header.astro'
import Footer from '../components/static/Footer.astro'




import { business } from '../data/business'

const contactItems = [
  { icon: 'M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z', label: 'Call or Text', value: business.phone, href: `tel:${business.phone.replace(/\s/g, '')}` },
  { icon: 'M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z', label: 'Landline', value: business.phoneLandline, href: `tel:${business.phoneLandline.replace(/\s/g, '')}` },
  { icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6', label: 'Email', value: business.email, href: `mailto:${business.email}` },
  { icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0zM12 13a3 3 0 100-6 3 3 0 000 6z', label: 'Address', value: business.address.full, href: null },
  { icon: 'M12 22a10 10 0 100-20 10 10 0 000 20zM12 6v6l4 2', label: 'Working Hours', value: 'Mon-Fri: 8am-6pm | Sat: 9am-2pm | Emergency 7 days', href: null },
]
---

<Base title="Contact" description="Get in touch with Gas Champion for a free, no-obligation quote.">
  
    <TopBar />
    <Header><MobileNavIsland client:only="react" /></Header>

    <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold mb-4">Contact Gas Champion</h1>
        <p class="text-lg" style="color: var(--color-foreground-muted)">Get in touch for a free, no-obligation quote. We respond within 2 hours.</p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12">
          <div>
            <h2 class="font-heading text-2xl font-bold mb-8">Get In Touch</h2>
            <div class="space-y-6">
              {contactItems.map((item) => {
                const Tag = item.href ? 'a' : 'div'
                return (
                  <Tag href={item.href || undefined} class={`flex items-center gap-3 sm:gap-4 p-4 sm:p-5 rounded-theme-lg border min-w-0 ${item.href ? 'hover:shadow-theme transition-all' : ''}`} style={`background-color: var(--color-card-bg); border-color: var(--color-card-border);${item.href ? ' min-height: 44px;' : ''}`}>
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center shrink-0" style="background-color: color-mix(in srgb, var(--color-primary) 15%, transparent)">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-primary)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} /></svg>
                    </div>
                    <div class="min-w-0">
                      <div class="font-semibold text-sm sm:text-base">{item.label}</div>
                      <div class="text-sm break-words" style="color: var(--color-foreground-muted)">{item.value}</div>
                    </div>
                  </Tag>
                )
              })}
            </div>
            <div class="mt-8 rounded-theme-lg overflow-hidden" style="border: 1px solid var(--color-border)">
              <img src="/images/service-map.svg" alt="Gas Champion service area map" class="w-full h-auto" width="800" height="400" />
            </div>
          </div>
          <ContactFormIsland client:only="react" />
        </div>
      </div>
    </section>

    <Footer />
    
  
</Base>
