---
import Base from '../../layouts/Base.astro'
import MobileNav from '../../components/static/MobileNav.astro'
import TopBar from '../../components/static/TopBar.astro'
import Header from '../../components/static/Header.astro'
import ServiceCard from '../../components/static/ServiceCard.astro'
import CTABanner from '../../components/static/CTABanner.astro'
import Footer from '../../components/static/Footer.astro'



const { business, services, layoutConfig } = Astro.locals.tenant
const servicesVariant = layoutConfig?.services || 'grid'
---

<Base title="Our Services" description={business.yearsExperience > 0 ? `Expert boiler and heating services from a Gas Safe registered engineer with ${business.yearsExperience}+ years experience.` : `Expert boiler and heating services from a Gas Safe registered engineer in ${business.address.town}.`}>
  
    <TopBar />
    <Header><MobileNav /></Header>

    <section class="py-16 md:py-24" style="background-color: var(--color-hero-bg); color: var(--color-hero-text)">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold mb-4">Our Services</h1>
        <p class="text-lg max-w-2xl mx-auto" style="color: var(--color-foreground-muted)">Expert boiler and heating services from a Gas Safe registered engineer{business.yearsExperience > 0 ? ` with ${business.yearsExperience}+ years of experience` : ` serving ${business.address.town} and surrounding areas`}.</p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4">

        {servicesVariant === 'list' ? (
          <div class="flex flex-col gap-4">
            {services.map((s) => (
              <a href={`/services/${s.id}`} class="group flex items-start gap-5 p-5 sm:p-6 rounded-xl transition-all hover:shadow-lg hover:-translate-y-0.5" style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);">
                <div class="w-12 h-12 rounded-lg flex items-center justify-center shrink-0" style="background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" /></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between mb-1">
                    <h3 class="text-base sm:text-lg font-bold" style="color: var(--color-foreground);">{s.name}</h3>
                    <span class="text-sm font-bold shrink-0 ml-4" style="color: var(--color-primary);">From {s.fromPrice}</span>
                  </div>
                  <p class="text-sm mb-2.5 leading-relaxed" style="color: var(--color-foreground-muted);">{s.shortDesc}</p>
                  <div class="flex flex-wrap gap-x-4 gap-y-1.5">
                    {s.features.slice(0, 4).map((f) => (
                      <span class="flex items-center gap-1.5 text-xs sm:text-sm" style="color: var(--color-foreground);">
                        <svg class="shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                        {f}
                      </span>
                    ))}
                  </div>
                </div>
                <svg class="shrink-0 mt-1 transition-transform group-hover:translate-x-1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
              </a>
            ))}
          </div>

        ) : servicesVariant === 'cards' ? (
          <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
            {services.map((s) => (
              <a href={`/services/${s.id}`} class="group block rounded-xl overflow-hidden transition-all hover:shadow-xl hover:-translate-y-1" style="background-color: var(--color-card-bg); border: 1px solid var(--color-card-border);">
                <div class="flex h-full">
                  <div class="w-1.5 shrink-0" style="background-color: var(--color-primary);"></div>
                  <div class="p-6 sm:p-8 flex flex-col flex-1">
                    <div class="flex items-start justify-between mb-4">
                      <div class="w-12 h-12 rounded-lg flex items-center justify-center" style="background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" /></svg>
                      </div>
                      <span class="text-sm font-bold px-3 py-1 rounded-theme-full" style="background-color: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary);">From {s.fromPrice}</span>
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold mb-3" style="color: var(--color-foreground);">{s.name}</h3>
                    <p class="text-sm sm:text-base leading-relaxed mb-5 flex-1" style="color: var(--color-foreground-muted);">{s.shortDesc}</p>
                    <ul class="flex flex-col gap-2 mb-5">
                      {s.features.slice(0, 3).map((f) => (
                        <li class="flex items-center gap-2 text-sm" style="color: var(--color-foreground);">
                          <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                          {f}
                        </li>
                      ))}
                    </ul>
                    <div class="flex items-center gap-1.5 text-sm font-semibold transition-all group-hover:gap-2.5" style="color: var(--color-accent);">
                      Learn more
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>

        ) : (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((s) => (
              <ServiceCard id={s.id} name={s.name} shortDesc={s.shortDesc} icon={s.icon} fromPrice={s.fromPrice} features={[...s.features]} />
            ))}
          </div>
        )}

      </div>
    </section>

    <CTABanner />
    <Footer />
    
  
</Base>
