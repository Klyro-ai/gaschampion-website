---
import '../styles/global.css'
import { generateLocalBusinessSchema, generateFAQSchema } from '../lib/schema'
import Analytics from '../components/static/Analytics.astro'
import CookieConsent from '../components/static/CookieConsent.astro'

const { business, faqs } = Astro.locals.tenant

// Derive site origin from the request — no hardcoded domain
const siteOrigin = Astro.url.origin

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
const pageTitle = title
  ? `${title} | ${business.shortName}`
  : `${business.name} | ${business.tagline}`
const pageDesc = description || business.description
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="keywords" content={`gas engineer ${business.address.town}, boiler repair ${business.address.county}, boiler servicing ${business.address.town}, Gas Safe engineer, ${business.serviceAreas.slice(0, 3).map(a => `heating engineer ${a}`).join(', ')}, emergency boiler repair`} />
  <meta name="author" content={business.name} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={`${siteOrigin}${Astro.url.pathname}`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:url" content={`${siteOrigin}${Astro.url.pathname}`} />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  {business.socialMedia?.twitter && <meta name="twitter:site" content={business.socialMedia.twitter.includes('twitter.com/') ? `@${business.socialMedia.twitter.split('twitter.com/').pop()}` : business.socialMedia.twitter} />}
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />

  <!-- Fonts — non-render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />

  <link rel="icon" href="/favicon.ico" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(generateLocalBusinessSchema(business, siteOrigin))} />
  <script type="application/ld+json" set:html={JSON.stringify(generateFAQSchema(faqs))} />

  <!-- Analytics & Tracking -->
  <Analytics />
</head>
<body class="antialiased">
  <main>
    <slot />
  </main>
  <CookieConsent />
</body>
</html>
